# 应用
LEO_APP_NAME=Leo Studio API
LEO_APP_VERSION=0.1.0
LEO_DEBUG=true

# 服务监听（默认端口 58685）
LEO_HOST=0.0.0.0
LEO_PORT=58685

# 跨域来源，逗号分隔；* 表示镜像请求来源
LEO_CORS_ORIGINS=*

# 数据目录与上传上限
LEO_DATA_DIR=.
LEO_CSV_DIR=./.leo-studio
LEO_UPLOAD_DIR=./storage/uploads/text-files
LEO_MAX_UPLOAD_SIZE_MB=50

# 文本文件模块
LEO_TEXT_FILES_ALLOWED_EXTENSIONS=.txt
LEO_TEXT_FILES_MAX_UPLOAD_SIZE_MB=
LEO_TEXT_FILES_MAX_FILENAME_LENGTH=255
# MCP（Model Context Protocol，仅 2026-07-28）
LEO_MCP_ENABLED=false
LEO_MCP_TRANSPORT=stdio
LEO_MCP_HTTP_PATH=/mcp
LEO_MCP_TOKEN=
LEO_MCP_WRITE_TOOLS=false
LEO_MCP_DESTRUCTIVE_TOOLS=false
LEO_MCP_ALLOW_FILE_PATH=false
LEO_MCP_ALLOWED_ROOTS=
LEO_MCP_MAX_CHARS=20000
LEO_MCP_MAX_PAGE_SIZE=100
LEO_MCP_LOG_LEVEL=info
