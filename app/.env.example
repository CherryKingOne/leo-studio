# 应用
LEO_APP_NAME=Leo Studio API
LEO_APP_VERSION=0.1.0
LEO_DEBUG=true

# 服务监听（默认端口 58685）
LEO_HOST=127.0.0.1
LEO_PORT=58685

# 跨域来源白名单，逗号分隔；:* 表示该主机任意端口；* 表示任意来源且不携带凭据（不推荐）
LEO_CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*,http://[::1]:*

# 可选 API Token；配置后需携带 Authorization: Bearer <token>（/health 除外）
LEO_API_TOKEN=

# 数据目录与上传上限
LEO_DATA_DIR=.
LEO_CSV_DIR=./.leo-studio
LEO_UPLOAD_DIR=./storage/uploads/text-files
LEO_MAX_UPLOAD_SIZE_MB=50

# 文本文件模块
LEO_TEXT_FILES_ALLOWED_EXTENSIONS=.txt
LEO_TEXT_FILES_MAX_UPLOAD_SIZE_MB=
LEO_TEXT_FILES_MAX_FILENAME_LENGTH=255
# MCP（Streamable HTTP，与 REST 同进程；true 开启，false 关闭，默认开启）
LEO_MCP_ENABLED=true
LEO_MCP_HTTP_PATH=/mcp
LEO_MCP_WRITE_TOOLS=true
LEO_MCP_DESTRUCTIVE_TOOLS=true
