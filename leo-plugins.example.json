{
  "disabled": [],
  "text": {
    "cleaners": ["kaomoji"],
    "chapter_splitter": "novel-regex",
    "dialogue_splitter": "quotes"
  },
  "exchange": {
    "default_exporter": "json"
  },
  "storage": {
    "default": "csv"
  },
  "tts": {
    "default": "edge"
  },
  "llm": {
    "default": "deepseek"
  },
  "settings": {
    "leo-plugin-tts-stepfun": {
      "model": "step-tts-2",
      "response_format": "mp3",
      "sample_rate": 24000,
      "default_voice": "cixingnansheng"
    },
    "leo-plugin-tts-minimax": {
      "model": "speech-2.8-hd",
      "format": "mp3",
      "sample_rate": 32000,
      "bitrate": 128000,
      "default_voice": "male-qn-qingse"
    },
    "leo-plugin-llm-deepseek": {
      "protocol": "openai-chat",
      "base_url": "https://api.deepseek.com/v1",
      "model": "deepseek-chat",
      "temperature": 0.7,
      "max_tokens": 4096,
      "stream": true,
      "thinking": {
        "mode": "enabled",
        "effort": "high"
      }
    },
    "leo-plugin-llm-volcengine": {
      "protocol": "openai-chat",
      "base_url": "https://ark.cn-beijing.volces.com/api/v3",
      "model": "ep-2026xxxxxxxx",
      "temperature": 0.7,
      "max_tokens": 4096,
      "stream": true,
      "thinking": "enabled",
      "reasoning_effort": "high"
    },
    "leo-plugin-llm-bailian": {
      "protocol": "openai-chat",
      "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "model": "qwen3.8-flash",
      "temperature": 0.7,
      "max_tokens": 4096,
      "stream": true,
      "reasoning_effort": "high"
    }
  }
}
