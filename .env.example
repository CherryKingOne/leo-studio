# ==============================================================================
# 🎙️ Leo Studio 环境变量配置文件模板 (.env.example)
#
# 使用方法：
#   cp .env.example .env
#   按需修改或填入自己的参数与 API Key，启动时程序会自动加载 .env 文件
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 基础服务与网络配置
# ------------------------------------------------------------------------------
LEO_APP_NAME="Leo Studio API"
LEO_APP_VERSION=0.2.0
LEO_DEBUG=true

# 服务监听地址与端口（默认 0.0.0.0:58685）
LEO_HOST=0.0.0.0
LEO_PORT=58685

# 跨域设置：* 表示允许所有来源镜像；或用逗号分隔多个域名
LEO_CORS_ORIGINS=*

# 日志级别：trace, debug, info, warn, error
RUST_LOG=info

# ------------------------------------------------------------------------------
# 2. 插件生态与商业 API Key（核心）
# ------------------------------------------------------------------------------
# 阶跃星辰 (StepFun) TTS 插件
# 官网获取 Key: https://platform.stepfun.com/interface-key
# 若不配置，该插件将自动跳过注册，不影响其他免费插件使用
STEPFUN_API_KEY=

# MiniMax 语音大模型 (Speech) TTS 插件
# 官网获取 Key: https://platform.minimax.cn/user-center/basic-information/interface-key
# 若不配置，该插件将自动跳过注册，不影响其他免费插件使用
MINIMAX_API_KEY=

# ------------------------------------------------------------------------------
# 2.1 大语言模型（LLM）插件 API Key
# ------------------------------------------------------------------------------
# DeepSeek（OpenAI Chat / Responses / Anthropic 兼容）
# 官网获取 Key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# 火山引擎方舟（豆包）
# 官网获取 Key: https://console.volcengine.com/ark
# 还需要在 leo-plugins.json 里把 model 填成控制台的推理接入点 ID（ep-...）
ARK_API_KEY=

# 阿里云百炼（Qwen / DashScope）
# 官网获取 Key: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=

# 插件配置文件路径（默认寻找当前目录下的 leo-plugins.json，若不需要自定义可留空）
# LEO_PLUGINS_CONFIG=./leo-plugins.json

# ------------------------------------------------------------------------------
# 3. 数据存储与文件上传
# ------------------------------------------------------------------------------
# 项目根数据目录
LEO_DATA_DIR=.

# CSV 持久化表存储目录（保存小说、章节、句子与多音字表）
LEO_CSV_DIR=./.leo-studio

# 原始文本文件上传存储目录
LEO_UPLOAD_DIR=./storage/uploads/text-files

# 单次文件上传最大体积（单位：MB）
LEO_MAX_UPLOAD_SIZE_MB=50

# 文本模块扩展名限制
LEO_TEXT_FILES_ALLOWED_EXTENSIONS=.txt
LEO_TEXT_FILES_MAX_FILENAME_LENGTH=255

# ------------------------------------------------------------------------------
# 4. MCP (Model Context Protocol) 智能体协议服务
# ------------------------------------------------------------------------------
# 是否启用 MCP 服务（true 开启，false 关闭）
LEO_MCP_ENABLED=true

# MCP Streamable HTTP 挂载路径（客户端连接：http://127.0.0.1:58685/mcp）
LEO_MCP_HTTP_PATH=/mcp

# 是否向 AI 智能体开放写入工具（新建剧目、追更、更新章节、保存多音字等）
LEO_MCP_WRITE_TOOLS=true

# 是否向 AI 智能体开放破坏性/删除类工具（删除章节、移入回收站、物理清空等）
LEO_MCP_DESTRUCTIVE_TOOLS=true
